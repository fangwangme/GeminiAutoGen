{
  "manifest_version": 3,
  "name": "Nano Banana Image Generator",
  "version": "5.0.1",
  "description": "Auto generate & download high-res images from Gemini with precise control",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "chunks/*.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open Nano Banana Image Generator"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
